# ==================================================
# Billora — Environment Variables
# ==================================================
# Copy this to .env.local and fill in your values.
# Never commit .env.local to source control.

# PostgreSQL connection string
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/billora

SESSION_SECRET=replace-with-a-long-random-secret

# Optional: site URL for OpenGraph metadata
# NEXT_PUBLIC_SITE_URL=https://billora.example.com

# Required for hosted Stripe TEST checkout. Live keys are intentionally rejected.
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# stripe listen --forward-to localhost:3000/api/stripe/webhook

# Django hospitality billing; shares SESSION_SECRET with Next.js.
DJANGO_API_URL=http://127.0.0.1:8000
# Optional: Django hospitality/settings/widgets database. Leave empty to retain SQLite.
# Paste the Neon PostgreSQL connection URL here; keep sslmode=require.
# HOSPITALITY_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# DATABASE_URL above controls the existing invoices/auth backend independently.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public origin encoded into QR codes. Use a reachable HTTPS origin when deployed.
PUBLIC_APP_URL=http://localhost:3000
# Optional separate Django framework key (defaults to SESSION_SECRET).
# DJANGO_SECRET_KEY=

# Production only: fail startup unless PostgreSQL, Redis, HTTPS, and strong keys exist.
# APP_ENV=production
# API_SIGNING_SECRET=<separate random secret, at least 32 characters; same on web/API>
# REDIS_URL=redis://localhost:6379/0
# DB_POOL_MAX=5
# WRITE_RATE_LIMIT=120
# REQUEST_LOG_LEVEL=INFO
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<base64-encoded 32-byte key shared by replicas>
